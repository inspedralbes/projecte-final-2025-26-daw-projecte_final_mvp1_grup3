# Credenciales Taiga MCP (pytaiga-mcp) — NO subir al repositorio
# Copia este archivo a taiga-mcp.env y rellena los valores:
#   cp .cursor/taiga-mcp.env.example .cursor/taiga-mcp.env

# API de Taiga en la nube (tree.taiga.io)
TAIGA_API_URL=https://api.taiga.io/api/v1/

# Usuario y contraseña de tu cuenta en https://tree.taiga.io
TAIGA_USERNAME=a24biedommar
TAIGA_PASSWORD=biel2006

# Transporte MCP (dejar stdio para Cursor)
TAIGA_TRANSPORT=stdio
LOG_LEVEL=INFO

# Referencia del proyecto en Taiga (solo documentación; el MCP usa project_id al consultar)
TAIGA_PROJECT_NAME=Projecte_final_MVP1_Grup3
