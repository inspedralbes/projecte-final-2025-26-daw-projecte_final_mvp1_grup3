# Frontend Nuxt 3.11.2
FROM mirror.gcr.io/library/node:20.18.3-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++

# Inclou package-lock.json al context (no l'excloguis a .dockerignore) per a npm ci
COPY package.json package-lock.json* ./

# Instal·la exactament les deps del projecte (inclou les devDependencies ja definides al package.json).
RUN if [ -f package-lock.json ]; then npm ci --legacy-peer-deps; else npm install --legacy-peer-deps; fi

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev"]
