# Frontend Nuxt 3.11.2
FROM mirror.gcr.io/library/node:20.18.3-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++

# Inclou package-lock.json al context (no l'excloguis a .dockerignore) per a npm ci
COPY package.json package-lock.json* ./

# Una sola capa RUN: menys passos d'exportació d'imatge
RUN if [ -f package-lock.json ]; then npm ci --legacy-peer-deps; else npm install --legacy-peer-deps; fi \
    && npm install -D tailwindcss@3.3.6 postcss@8 autoprefixer@10

COPY . .

ARG API_URL
ARG SOCKET_URL
ENV API_URL=$API_URL
ENV SOCKET_URL=$SOCKET_URL
ENV NUXT_PUBLIC_API_URL=$API_URL
ENV NUXT_PUBLIC_SOCKET_URL=$SOCKET_URL

RUN npm run build

RUN mkdir -p .output/server/chunks && \
    ln -s /app/.output/public /app/.output/server/chunks/public

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
